# MongoDB bağlantısı (real dəyəri yalnız .env.local faylında saxlayın)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/<database>

# Ən azı 32 simvol, təsadüfi (node ilə crypto.randomBytes(48).toString("hex") yarada bilərsiniz)
SESSION_SECRET=<long-random-secret>

# Reverse proxy arxasında proxy sayı (X-Forwarded-For etibarlı olanda), məsələn 1
# TRUST_PROXY=1

# Email təsdiqi qurulana qədər production-da müştəri qeydiyyatı bağlıdır
# ALLOW_PUBLIC_REGISTRATION=false

# Production-da create-admin skripti yalnız bu açar true olanda işləyir
# ALLOW_ADMIN_SETUP=false

# Saytın ictimai ünvanı (sitemap, canonical, hreflang və structured data üçün); sonda slash olmadan
# NEXT_PUBLIC_SITE_URL=https://example.com
